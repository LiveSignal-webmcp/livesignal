{
  "manifest_version": 3,
  "name": "LiveSignal",
  "short_name": "LiveSignal",
  "version": "0.3.2",
  "description": "Give agents structured access to livestream players and realtime speech evidence.",
  "minimum_chrome_version": "149",
  "permissions": ["activeTab", "offscreen", "storage", "tabCapture"],
  "host_permissions": [
    "https://livesignal-chi.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "LiveSignal realtime listening",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.twitch.tv/*"],
      "js": ["main-world.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://www.twitch.tv/*"],
      "js": ["status-badge.js"],
      "run_at": "document_idle"
    }
  ]
}
